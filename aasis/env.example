ANTHROPIC_API_KEY=sk-ant-...
# Opcional: sobrescreve o modelo definido em config.yaml
# AASIS_MODEL=claude-sonnet-5-5
# Home Assistant: Perfil > Segurança > Tokens de acesso de longa duração
HA_TOKEN=
# Acesso remoto/nuvem (12+ caracteres local/Tailscale; 20+ na nuvem)
AASIS_HUD_CODE=
# Nuvem: host público do serviço, sem https:// (vários separados por vírgula)
AASIS_ALLOWED_HOSTS=
# Nuvem: JSON da credencial Google tipo "Aplicativo da Web" (em uma linha)
GOOGLE_CLIENT_JSON=
# Nuvem: disco persistente (padrão da imagem Docker: /data)
# AASIS_DATA_DIR=/data
# Home Assistant acessível pela internet
# HA_URL=https://xxxx.ui.nabu.casa
# Orquestrador de IAs (opcional; veja docs/orchestrator.md). Só ficam ativos os provedores com chave.
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OLLAMA_MODEL=
