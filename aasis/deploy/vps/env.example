# Copie para .env nesta pasta e preencha. O arquivo .env NUNCA vai para o git (contém segredos).
# Regra: escreva o valor logo depois do "=", sem espaços e SEM comentário na mesma linha.

# Domínio apontando para o IP do VPS (sem https://)
AASIS_DOMAIN=

ANTHROPIC_API_KEY=

# Sua senha do AASIS: frase longa, 20+ caracteres
AASIS_HUD_CODE=

# Opcionais (tire o # para usar)
# Telegram: alertas confiáveis e conversa pelo celular (veja docs/telegram-meds.md)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Monitor externo (healthchecks.io); precisa ser https
# HEALTHCHECK_URL=
# GOOGLE_CLIENT_JSON=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# HA_URL=
# HA_TOKEN=
